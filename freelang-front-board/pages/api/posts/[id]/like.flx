(defn render_post [req]
  (let [id (str-to-num (get (get req "params") "id" "0"))
        result (db-exec (db-config) "UPDATE posts SET likes = likes + 1 WHERE id = ?" [id])]
    (if (> (get result "affectedRows" 0) 0)
      (server-json {:ok true})
      (server-status 404 (json-stringify {:error "게시글을 찾을 수 없습니다."})))))
