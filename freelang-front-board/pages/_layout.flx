(define BOARD-CSS "<style>
*{box-sizing:border-box}body{margin:0;background:#f6f7fb;color:#172033;font-family:Arial,sans-serif}header{background:#243b6b;padding:16px}header a{color:white;font-weight:700;text-decoration:none}main{max-width:720px;margin:0 auto;padding:28px 16px}h1{margin:0 0 12px}h2{font-size:1.1rem;margin:0 0 8px}a{color:#1e4f9e}.card,.detail,.editor,.search{background:#fff;border:1px solid #d8dde7;border-radius:10px;padding:18px;margin:0 0 14px}.meta{color:#596579;font-size:.9rem}.summary{line-height:1.5}.row{display:flex;align-items:center;justify-content:space-between;gap:12px;margin-bottom:20px}.search-row,.actions,.pagination{display:flex;gap:8px;flex-wrap:wrap}input,textarea{width:100%;padding:9px;border:1px solid #aeb8c8;border-radius:6px;font:inherit}textarea{resize:vertical}button,.button-link{background:#2457a5;border:0;border-radius:6px;color:#fff;cursor:pointer;display:inline-block;font:inherit;padding:9px 13px;text-decoration:none}.secondary{background:#67748a}.pagination a{border:1px solid #aeb8c8;border-radius:5px;padding:7px 10px;text-decoration:none}.body{line-height:1.7;white-space:pre-wrap}.field{margin-bottom:14px}.field label{display:block;font-weight:700;margin-bottom:5px}.error{color:#b42318;margin:5px 0 0}@media(max-width:375px){main{padding:20px 12px}.row,.search-row{align-items:flex-start;flex-direction:column}}</style>")

(defn layout-html [title content req]
  (str "<!doctype html><html lang='ko'><head><meta charset='utf-8'><meta name='viewport' content='width=device-width,initial-scale=1'><title>" title "</title>" BOARD-CSS "</head><body><header><a href='/' data-spa='1'>공지사항 게시판</a></header><main>" content "</main></body></html>"))
